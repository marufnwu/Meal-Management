# Copy this file to local.properties and fill in your values
# This file contains local configuration that should NOT be committed to version control

# Android SDK location (usually auto-generated by Android Studio)
# sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Choose one of the available server URLs by uncommenting the desired one:

# Local development server
BASE_URL="http://192.168.0.90/"

# Alternative local servers (uncomment one):
# BASE_URL="http://192.168.31.9/"
# BASE_URL="http://192.168.31.2/mess_management/"
# BASE_URL="http://192.168.0.184/mess_management/"
# BASE_URL="http://192.168.31.90/mess_management/"

# Staging/Testing servers (uncomment one):
# BASE_URL="http://meal.try3x.xyz/"
# BASE_URL="http://md.local/"

# Production servers (uncomment one):
# BASE_URL="https://mealmanagement.xyz/"
# BASE_URL="https://mydining.xyz/"

# =============================================================================
# USER CREDENTIALS
# =============================================================================

# Default test credentials (change these for your environment)
USER_NAME="lmp_video"
USER_PASSWORD="6278374886"

# Alternative test credentials (uncomment and modify as needed):
# USER_NAME="your_test_username"
# USER_PASSWORD="your_test_password"

# =============================================================================
# SIGNING CONFIGURATION (for release builds)
# =============================================================================

# Keystore file path (relative to project root or absolute path)
KEYSTORE_PATH="mydining.jks"

# Alternative keystore options:
# KEYSTORE_PATH="meal.jks"
# KEYSTORE_PATH="C:\\path\\to\\your\\keystore.jks"

# Keystore credentials
KEYSTORE_PASSWORD="1M@ruf21"
KEY_ALIAS="maruf"
KEY_PASSWORD="1M@ruf21"

# Alternative signing credentials (uncomment and modify as needed):
# KEYSTORE_PASSWORD="your_keystore_password"
# KEY_ALIAS="your_key_alias"
# KEY_PASSWORD="your_key_password"

# =============================================================================
# DEVELOPMENT TIPS
# =============================================================================

# 1. Copy this file to local.properties
# 2. Uncomment and modify the values you need
# 3. Keep this file out of version control (it's already in .gitignore)
# 4. Share this example file with your team
# 5. Each developer can have their own local.properties with their preferred settings

# Quick server switching:
# - For local development: use 192.168.x.x URLs
# - For testing: use try3x.xyz or md.local
# - For production: use mealmanagement.xyz or mydining.xyz

# Quick credential switching:
# - Use test credentials for development
# - Use real credentials for testing production features