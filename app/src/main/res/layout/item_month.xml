<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Changed to MaterialCardView for better UI -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/content_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/_4sdp"
        app:cardCornerRadius="@dimen/_1sdp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_14sdp">

            <!-- Name with custom background accent -->
            <TextView
                android:id="@+id/tv_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/chip_status"
                app:layout_constraintHorizontal_bias="0.0"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="@string/month_name_placeholder"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold" />

            <!-- Type with Icon -->
            <ImageView
                android:id="@+id/iv_type_icon"
                app:layout_constraintBottom_toBottomOf="@id/tv_type"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_type"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/start_24px"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/content_desc_type_icon" />

            <TextView
                android:id="@+id/tv_type"
                app:layout_constraintStart_toEndOf="@id/iv_type_icon"
                app:layout_constraintTop_toBottomOf="@id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/month_type_automatic"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/_11sdp" />

            <!-- Status with Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                app:chipBackgroundColor="@color/active_bg_color"
                app:chipMinHeight="24dp"
                app:chipMinTouchTargetSize="24dp"
                app:ensureMinTouchTargetSize="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_name"
                app:layout_constraintBottom_toBottomOf="@id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/month_status_active"
                android:textColor="@color/active_text_color"
                android:textSize="12sp" />

            <!-- Date Range with Calendar Icon -->
            <ImageView
                android:id="@+id/iv_calendar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_type"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:src="@drawable/calendar_view_month_24px"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/content_desc_calendar_icon" />

            <TextView
                android:id="@+id/tv_date_range"
                app:layout_constraintBottom_toBottomOf="@id/iv_calendar"
                app:layout_constraintStart_toEndOf="@id/iv_calendar"
                app:layout_constraintTop_toTopOf="@id/iv_calendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:text="@string/month_date_range_placeholder"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/_11sdp" />


            <!-- Selection Icon with circular background -->
            <FrameLayout
                android:id="@+id/selection_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chip_status"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/iv_selected"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/check"
                    android:contentDescription="@string/content_desc_selection_icon" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
