<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Left side content container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/_16sdp">

        <!-- Name with custom background accent -->
        <TextView
            android:id="@+id/tv_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="Lulu"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold" />

        <!-- Type with Icon -->
        <ImageView
            android:id="@+id/iv_type_icon"
            app:layout_constraintBottom_toBottomOf="@id/tv_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_type"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/informing" />

        <TextView
            android:id="@+id/tv_type"
            app:layout_constraintStart_toEndOf="@id/iv_type_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Automatic"
            android:textSize="14sp" />

        <!-- Status with Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_status"
            app:chipBackgroundColor="@color/active_bg_color"
            app:chipMinHeight="24dp"
            app:chipMinTouchTargetSize="24dp"
            app:ensureMinTouchTargetSize="false"
            app:layout_constraintBottom_toBottomOf="@id/tv_name"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="Active"
            android:textColor="@color/active_text_color"
            android:textSize="12sp" />

        <!-- Date Range with Calendar Icon -->
        <ImageView
            android:id="@+id/iv_calendar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_type"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:src="@drawable/calendar" />

        <TextView
            android:id="@+id/tv_date_range"
            app:layout_constraintBottom_toBottomOf="@id/iv_calendar"
            app:layout_constraintStart_toEndOf="@id/iv_calendar"
            app:layout_constraintTop_toTopOf="@id/iv_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:text="May 1 - May 31, 2025"
            android:textSize="13sp" />


        <!-- Selection Icon with circular background -->
        <FrameLayout
            android:id="@+id/selection_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chip_status"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_margin="@dimen/_8sdp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/iv_selected"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/check" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
