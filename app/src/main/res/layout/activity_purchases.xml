<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.PurchasesActivity">

    <LinearLayout
        android:background="@drawable/bottom_curve"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/llHeader"
        android:paddingBottom="@dimen/_10sdp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp">

        <TextView
            android:textSize="@dimen/_12sdp"
            android:id="@+id/txtTotalPurchase"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:layout_margin="@dimen/_12sdp"
            android:layout_gravity="center"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:text="@string/total_purchase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
   <com.google.android.material.card.MaterialCardView
       app:cardBackgroundColor="?attr/colorSurfaceVariant"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintBottom_toBottomOf="parent"
       android:layout_width="match_parent"
       android:layout_marginTop="@dimen/_50sdp"
       android:layout_marginBottom="@dimen/_8sdp"
       android:layout_marginHorizontal="@dimen/_12sdp"
       android:layout_height="0dp">
       <RelativeLayout
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toBottomOf="@+id/llHeader"
           android:layout_width="match_parent"
           android:layout_height="match_parent">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:layout_margin="@dimen/_5sdp"
               android:layout_above="@+id/layoutAction"
               android:orientation="vertical">

               <com.google.android.material.card.MaterialCardView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   app:cardCornerRadius="@dimen/_6sdp"
                   app:cardElevation="@dimen/_1sdp">

                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:gravity="center"
                       android:background="?attr/colorSecondary"
                       android:orientation="horizontal">

                       <TextView
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:gravity="center"
                           android:padding="@dimen/_8sdp"
                           android:text="@string/date"
                           android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                           android:textColor="@color/White" />

                       <View
                           android:layout_width="1dp"
                           android:layout_height="match_parent"
                           android:alpha="0.5"
                           android:background="@color/White" />

                       <TextView
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:gravity="center"
                           android:padding="@dimen/_8sdp"
                           android:text="@string/name"
                           android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                           android:textColor="@color/White" />

                       <View
                           android:layout_width="1dp"
                           android:layout_height="match_parent"
                           android:alpha="0.5"
                           android:background="@color/White" />

                       <TextView
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:gravity="center"
                           android:padding="@dimen/_8sdp"
                           android:text="@string/product"
                           android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                           android:textColor="@color/White" />

                       <View
                           android:layout_width="1dp"
                           android:layout_height="match_parent"
                           android:alpha="0.5"
                           android:background="@color/White" />

                       <TextView
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_weight="1"
                           android:gravity="center"
                           android:padding="@dimen/_8sdp"
                           android:text="@string/price"
                           android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                           android:textColor="@color/White" />
                   </LinearLayout>
               </com.google.android.material.card.MaterialCardView>

               <androidx.recyclerview.widget.RecyclerView
                   android:id="@+id/recyPurchase"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:clipToPadding="false"
                   android:paddingTop="@dimen/_4sdp"
                   android:paddingBottom="@dimen/_4sdp" />
           </LinearLayout>

           <FrameLayout
               android:id="@+id/layoutAction"
               android:layout_alignParentBottom="true"
               android:layout_width="match_parent"
               android:layout_height="wrap_content">
               <LinearLayout
                   android:visibility="visible"
                   android:id="@+id/layoutAdminPurchase"
                   android:orientation="horizontal"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content">

                   <com.google.android.material.button.MaterialButton
                       style="@style/Widget.Material3.Button.IconButton.Filled"
                       app:icon="@drawable/baseline_add_circle_24"
                       android:id="@+id/btnAddPurchase"
                       android:layout_weight="1"
                       android:layout_width="0dp"
                       android:layout_height="wrap_content"
                       android:layout_marginStart="@dimen/_8sdp"
                       android:layout_marginTop="@dimen/_8sdp"
                       android:layout_marginEnd="@dimen/_8sdp"
                       android:layout_marginBottom="@dimen/_8sdp"
                       android:text="@string/add_purchase" />

               </LinearLayout>






           </FrameLayout>
       </RelativeLayout>
   </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>