<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.DepositActivity">

    <LinearLayout
        android:background="@drawable/bottom_curve"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/llHeader"
        android:paddingBottom="@dimen/_10sdp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp">

        <TextView
            android:textSize="@dimen/_12sdp"
            android:id="@+id/txtPageTitle"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:layout_margin="8dp"
            android:layout_gravity="center"
            android:textColor="@color/White"
            android:text="@string/total_deposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_height="0dp">
        <RelativeLayout
            android:layout_margin="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyDeposit"
                android:layout_above="@+id/btnAddDeposit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <com.google.android.material.button.MaterialButton
                app:icon="@drawable/baseline_add_circle_24"
                android:layout_marginTop="@dimen/_8sdp"
                android:id="@+id/btnAddDeposit"
                android:layout_alignParentBottom="true"
                android:textColor="@color/White"
                android:text="@string/add_deposit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>



</androidx.constraintlayout.widget.ConstraintLayout>