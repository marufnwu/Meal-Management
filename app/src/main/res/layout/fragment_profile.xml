<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Header with Avatar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:orientation="vertical"
        android:padding="@dimen/_24sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/_16sdp"
            android:text="Profile"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold" />

        <!-- Avatar Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:layout_gravity="center"
                app:cardCornerRadius="@dimen/_50sdp"
                app:cardElevation="@dimen/_4sdp">

                <ImageView
                    android:id="@+id/ivProfilePicture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/person_24px" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/btnChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_8sdp"
                android:text="Change Photo"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/_12sdp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp">

            <!-- View Mode Fields -->
            <LinearLayout
                android:id="@+id/viewModeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.logicline.mydining.ui.custom.MaterialIconField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fieldIcon="@drawable/person_24px">                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_12sdp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/_14sdp"
                        tools:text="John Doe" />

                </com.logicline.mydining.ui.custom.MaterialIconField>

                <com.logicline.mydining.ui.custom.MaterialIconField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fieldIcon="@drawable/mail_24px">                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_12sdp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/_14sdp"
                        tools:text="john@example.com" />

                </com.logicline.mydining.ui.custom.MaterialIconField>

                <com.logicline.mydining.ui.custom.MaterialIconField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fieldIcon="@drawable/phone_in_talk_24px">                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_12sdp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/_14sdp"
                        tools:text="+1234567890" />

                </com.logicline.mydining.ui.custom.MaterialIconField>

                <com.logicline.mydining.ui.custom.MaterialIconField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fieldIcon="@drawable/wc_24px">                    <TextView
                        android:id="@+id/tvGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_12sdp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/_14sdp"
                        tools:text="Male" />

                </com.logicline.mydining.ui.custom.MaterialIconField>

                <com.logicline.mydining.ui.custom.MaterialIconField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fieldIcon="@drawable/ic_location">                    <TextView
                        android:id="@+id/tvCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_12sdp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/_14sdp"
                        tools:text="New York" />

                </com.logicline.mydining.ui.custom.MaterialIconField>

            </LinearLayout>

            <!-- Edit Mode Fields -->
            <LinearLayout
                android:id="@+id/editModeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.logicline.mydining.ui.custom.MaterialIconEditTextField
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    app:fieldIcon="@drawable/person_24px" />

                <com.logicline.mydining.ui.custom.MaterialIconEditTextField
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email Address"
                    android:inputType="textEmailAddress"
                    app:fieldIcon="@drawable/mail_24px" />

                <com.logicline.mydining.ui.custom.MaterialIconEditTextField
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    app:fieldIcon="@drawable/phone_in_talk_24px" />

                <com.logicline.mydining.ui.custom.MaterialIconField
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:fieldIcon="@drawable/wc_24px">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="Gender"
                        android:inputType="none"
                        android:padding="@dimen/_12sdp" />

                </com.logicline.mydining.ui.custom.MaterialIconField>

                <com.logicline.mydining.ui.custom.MaterialIconEditTextField
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="City"
                    android:inputType="textPostalAddress"
                    app:fieldIcon="@drawable/ic_location" />

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24sdp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:text="Edit Profile"
                    app:icon="@drawable/edit_24px" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:text="Save"
                    android:visibility="gone"
                    app:icon="@drawable/check_24px" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:visibility="gone"
                    app:icon="@drawable/close_24px" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

    </FrameLayout>

</LinearLayout>
